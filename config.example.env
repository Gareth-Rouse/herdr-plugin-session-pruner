# Session Pruner configuration.
# Copy to $(herdr plugin config-dir garethrouse.session-pruner)/config.env
# and uncomment what you want to change. Environment variables win over this
# file, so a launcher wrapper can override any of it.

# live | snapshot | off
#SESSION_PRUNER_MODE=live

# A workspace is cold after this long without focus. 0 disables age pruning.
#SESSION_PRUNER_TTL_HOURS=24

# Keep at most N workspaces, oldest-used dropped first. 0 = unlimited.
#SESSION_PRUNER_KEEP_MAX=0

# Never prune below this many workspaces.
#SESSION_PRUNER_KEEP_MIN=1

# Extended regex of workspace names that are never pruned.
#SESSION_PRUNER_PROTECT="^(ops|dotfiles)$"

# Keep workspaces whose agent is mid-task (live mode only).
#SESSION_PRUNER_PROTECT_BUSY_AGENTS=1

# Sidebar token reporting.
#SESSION_PRUNER_LABELS=1
#SESSION_PRUNER_LABEL_TOKEN=last_used
#SESSION_PRUNER_PINNED_LABEL=pin

# Log what would be pruned, prune nothing.
#SESSION_PRUNER_DRY_RUN=0
